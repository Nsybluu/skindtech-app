# Address of the SKINDTECH Express backend as seen from the phone / simulator.
# `localhost` only works in the iOS simulator. A physical phone needs the Mac's
# LAN address (it can change with DHCP: check with `ipconfig getifaddr en0`).
EXPO_PUBLIC_API_URL=http://YOUR_MAC_LAN_IP:3000

# Demo fallback for POST /scans, used ONLY when the API cannot be reached
# (offline, services down, wrong address) or answers with a 5xx.
#   mock   show the sample "moderate acne" result, badged "Demo data"
#   clear  show the sample "no visible acne" result, badged "Demo data"
#   off    show the real "Analysis failed" screen
# If unset: `mock` in development builds, `off` in release builds.
# A rejected photo, an expired session or a rate limit are never replaced by demo data.
EXPO_PUBLIC_SCAN_FALLBACK=off
